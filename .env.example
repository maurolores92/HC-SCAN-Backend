# ==========================================
# HC-SCAN Backend - Variables de Entorno
# ==========================================

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hc_scan
DB_FORCE_SYNC=false

# Autenticación JWT
JWT_SECRET=change_me_super_secret_jwt_key
JWT_EXPIRES_IN=8h

# Almacenamiento Multitenant (SFTP / Local Watcher + Bóveda)
# Se crean automáticamente: storage/tenancy/company_<id>/{inbox,vault,quarantine}
STORAGE_ROOT_PATH=./storage
DISABLE_INBOX_WATCHER=false

# Extracción Inteligente OCR / Multimodal con Gemini (Opcional en local: usa fallback heurístico si está vacía)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

